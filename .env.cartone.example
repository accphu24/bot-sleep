# ===== BOT CARTONE (auto buy + bxh + sold + react legit + ĐẾM legit) =====
BOT_PROFILE=cartone
# Token / Client ID của bot CARTONE (application Discord riêng, khác bot Drew)
DISCORD_TOKEN=
CLIENT_ID=
# ID server Cartone
ALLOWED_GUILD_IDS=

# Cả 2 bot dùng CHUNG 4 biến dưới đây (không phải chuyển dữ liệu): MONGODB_URI, MONGODB_DB, MAIN_GUILD_ID, DATA_ENCRYPTION_KEY, OWNER_ID
OWNER_ID=
MONGODB_URI=
MONGODB_DB=autobuy
MAIN_GUILD_ID=1462789815333289986
DATA_ENCRYPTION_KEY=

# Số legit đầu tiên khi DB chưa có bộ đếm của server Cartone (sau đó chỉnh bằng /config legit_count)
LEGIT_START=
# Cần: kênh legit (/config set muc:Kênh legit), danh mục Sold (/set_kenhsold hoặc /config set), STAFF_ROLE_ID hoặc /staff add
# 3 emoji react mặc định là emoji của Drew Store: bot Cartone phải ở chung server chứa emoji đó,
# hoặc up emoji vào server Cartone rồi đặt:  LEGIT_REACT_EMOJIS=<a:ten:id> <:ten:id> <a:ten:id>
