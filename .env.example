# ===== BẮT BUỘC =====
DISCORD_TOKEN=
CLIENT_ID=
OWNER_ID=

# MongoDB (Railway: thêm plugin MongoDB rồi tham chiếu ${{MongoDB.MONGO_URL}}; hoặc dùng chuỗi mongodb+srv:// của Atlas)
MONGODB_URI=
MONGODB_DB=autobuy

# Khóa mã hóa thông tin đăng nhập tài khoản (>= 16 ký tự). MẤT KHÓA = KHÔNG ĐỌC LẠI ĐƯỢC. Hãy sao lưu ở nơi an toàn.
# Tạo khóa:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# ===== CẤU HÌNH SHOP =====
STAFF_ROLE_ID=
LINK_QR=
TICKET_CATEGORY_ID=
STOCK_ID=
SOLD_CATEGORY_ID=
BILL_ID=
TRANSCRIPT_ID=
KENH_VOUCH=
KENH_YOUTUBE=
KENH_2FA=
KENH_LOCK=

# ===== KÊNH LEGIT (tùy chọn) =====
# Kênh đếm legit: chỉ tin đúng mẫu "+1 legit <@người_bán> ..." mới được đếm
AUTOREACTER_VOUCH=
LEGIT_START=800
VOUCH_MENTION_ID=
# Emoji chữ LEGIT và chữ số (dạng <:tên:id>), có thể bỏ trống
EMOJI_L=
EMOJI_E=
EMOJI_G=
EMOJI_I=
EMOJI_T=
EMOJI_DIVIDER=
# EMOJI_0..EMOJI_9 và EMOJI_0_ALT..EMOJI_9_ALT tương tự

# ===== EMOJI GIAO DIỆN (tùy chọn, mặc định dùng emoji của Drew Store) =====
# EMOJI_INFO=
# EMOJI_ONLINE=
# EMOJI_OFFLINE=
