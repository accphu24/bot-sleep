# ===== BẮT BUỘC =====
DISCORD_TOKEN=
CLIENT_ID=
OWNER_ID=

# MongoDB (Railway: thêm plugin MongoDB rồi tham chiếu ${{MongoDB.MONGO_URL}}; hoặc dùng chuỗi mongodb+srv:// của Atlas)
MONGODB_URI=
MONGODB_DB=autobuy

# Khóa mã hóa thông tin đăng nhập tài khoản (>= 16 ký tự). MẤT KHÓA = KHÔNG ĐỌC LẠI ĐƯỢC. Hãy sao lưu ở nơi an toàn.
# Tạo khóa:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# ===== CẤU HÌNH SHOP =====
STAFF_ROLE_ID=
LINK_QR=
TICKET_CATEGORY_ID=
STOCK_ID=
SOLD_CATEGORY_ID=
BILL_ID=
TRANSCRIPT_ID=
KENH_VOUCH=
KENH_YOUTUBE=
KENH_2FA=
KENH_LOCK=

# ===== KÊNH LEGIT =====
# Kênh đếm legit: chỉ tin đúng mẫu "+1 legit <@người_bán> ..." mới được đếm.
# Mỗi lần: +1 vào bộ đếm, bot react 3 emoji, và đổi tên kênh thành 『✅』𝙇𝙀𝙂𝙄𝙏-<số>
# (bot cần quyền Manage Channels + Add Reactions + Use External Emojis trong kênh này)
AUTOREACTER_VOUCH=
# Số legit của lần legit ĐẦU TIÊN khi DB chưa có bộ đếm (kênh đang hiện 632 thì để 633).
# Sau khi bot chạy có thể chỉnh bằng lệnh /config legit_count
LEGIT_START=633
VOUCH_MENTION_ID=

# ===== TÙY CHỌN (có thể bỏ trống) =====
# Mỗi khách được mở tối đa bao nhiêu đơn chưa xác nhận cùng lúc (mặc định 2)
# MAX_OPEN_TICKETS=2
# Chống spam kênh legit: 1 người chỉ được đếm 1 lần / số giây này (mặc định 20, 0 = tắt)
# LEGIT_COOLDOWN_SEC=20
# 3 emoji react (cách nhau bằng dấu cách). Mặc định đã là 3 emoji CanhXanh / minecraft_accept của Drew Store
# LEGIT_REACT_EMOJIS=<a:CanhXanh:1556987445437014116> <:minecraft_accept:1556987449996218409> <a:CanhXanh:1541014174312828968>

# ===== EMOJI GIAO DIỆN (tùy chọn, mặc định dùng emoji của Drew Store) =====
# EMOJI_INFO=
# EMOJI_ONLINE=
# EMOJI_OFFLINE=

# Ghi chú: các kênh/danh mục ở trên (STOCK_ID, TICKET_CATEGORY_ID, SOLD_CATEGORY_ID, BILL_ID, TRANSCRIPT_ID,
# KENH_VOUCH, KENH_YOUTUBE, KENH_2FA, KENH_LOCK, AUTOREACTER_VOUCH) và STAFF_ROLE_ID có thể đặt lại ngay trong
# Discord bằng /config và /staff (Owner), giá trị đặt bằng lệnh sẽ ưu tiên hơn biến môi trường.
